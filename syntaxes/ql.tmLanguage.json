{
  "scopeName": "source.ql",
  "patterns": [
    {
      "name": "keyword.control.ql",
      "match": "\\b(?i:SOURCE|MAP|MAP_MANY|FILTER|GROUP_BY|SORT_BY|LIMIT|AND|OR|ASC|DESC|AS|HEADERS|SUM|ARRAY|MINDATE|MAXDATE|COUNT|GETDATE)\\b"
    },
    {
      "name": "string.quoted.single.ql",
      "begin": "'",
      "end": "'"
    },
    {
      "name": "constant.numeric.ql",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    {
      "name": "comment.line.double-dash.ql",
      "match": "--.*$"
    }
  ]
}
